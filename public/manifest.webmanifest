{"name":"The Azuki Room","short_name":"Azuki Room","description":"A hidden Japanese dining room in the heart of Chancery Lane. Intimate 30-cover izakaya with charcoal yakitori, robatayaki, sushi, lunchtime ramen and an unlimited Saturday sushi brunch. All dishes prepared with halal, non-alcoholic ingredients.","start_url":"/","display":"standalone","background_color":"#1A1A1A","theme_color":"#1A1A1A","icons":[{"src":"/favicon.ico","sizes":"48x48","type":"image/x-icon"},{"src":"/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"}],"categories":["food","lifestyle"],"lang":"en-GB"}